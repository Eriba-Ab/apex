---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { COMPANY, CONTACT, NAV, SERVICES, FUNCTIONS } from '../data/site';

interface Props { title: string; description: string; page?: string; close?: boolean; }
const { title, description, page = '', close = true } = Astro.props;
const fullTitle = title === 'Home' ? `${COMPANY} | Cyber security services, Sevenoaks, Kent` : `${title} | ${COMPANY}`;
const isExt = (h: string) => /^https?:/.test(h);
const current = (h?: string) => (h && h === `${page}.html` ? 'page' : undefined);
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#0b1f33">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..800&family=Public+Sans:ital,wght@0,400..700;1,400&family=Red+Hat+Mono:wght@500;700&display=swap" rel="stylesheet">
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="watch" data-band="INK">
    <div class="wrap">
      <span class="watch-label"><b>Security operations</b> <span class="wl-long">on watch, 24 hours a day</span></span>
      <div class="watch-track" aria-hidden="true">
        <div class="watch-ticks">{Array.from({ length: 25 }, () => <i />)}</div>
        <div class="watch-done"></div>
        <div class="watch-now"></div>
      </div>
      <span class="watch-clock code" data-clock>UK</span>
      <a class="watch-phone" href={CONTACT.phoneHref}>Incident? {CONTACT.phone}</a>
    </div>
  </div>

  <header class="header">
    <div class="wrap">
      <a class="logo" href="index.html" aria-label={`${COMPANY}, home`}><Logo /></a>
      <nav class="nav" aria-label="Main">
        {NAV.map((n) => n.items ? (
          <div class="nav-item">
            <button type="button" aria-expanded="false">{n.label}<Icon name="chevron" /></button>
            <ul class="nav-menu">
              {n.items.map(([t, h]) => <li><a href={h} aria-current={current(h)} {...(isExt(h) ? { target: '_blank', rel: 'noopener' } : {})}>{t}</a></li>)}
            </ul>
          </div>
        ) : (
          <div class="nav-item"><a href={n.href} aria-current={current(n.href)}>{n.label}</a></div>
        ))}
      </nav>
      <a class="btn nav-cta" href="contact-us.html">Contact us</a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
    </div>
  </header>

  <div class="mobile-nav" id="mobile-nav" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="mobile-nav-top">
      <a class="logo" href="index.html" aria-label={`${COMPANY}, home`}><Logo size="sm" /></a>
      <button class="burger" type="button" aria-label="Close menu" data-close><Icon name="close" /></button>
    </div>
    {NAV.map((n) => n.items ? (
      <details><summary>{n.label}<Icon name="chevron" /></summary>{n.items.map(([t, h]) => <a href={h}>{t}</a>)}</details>
    ) : <a href={n.href}>{n.label}</a>)}
    <a href="contact-us.html">Contact</a>
    <a class="btn" href={CONTACT.phoneHref}><Icon name="phone" />Call {CONTACT.phone}</a>
  </div>

  <main id="main">
    <slot />
  </main>

  {close && (
    <section class="section close" data-band="INK" aria-labelledby="close-title">
      <div class="wrap close-grid">
        <div>
          <h2 id="close-title">Put Apex on your shortlist.</h2>
          <p class="lede muted" style="margin-top:1.5rem">Tell us what you are buying for, whether that's a risk assessment, 24/7 monitoring, a network build or a camera system, and we’ll come back with a scope you can take to your team.</p>
        </div>
        <div class="close-lines">
          <a href="contact-us.html">Start a conversation <span>Scope, tenders, partnering</span></a>
          <a href={`mailto:${CONTACT.email}?subject=Request%20for%20information`}>{CONTACT.email} <span>Email</span></a>
          <a href={CONTACT.phoneHref}>{CONTACT.phone} <span>Office, including incidents</span></a>
          <a href={CONTACT.mobileHref}>{CONTACT.mobile} <span>Mobile</span></a>
        </div>
      </div>
    </section>
  )}

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a class="footer-logo" href="index.html" aria-label={`${COMPANY}, home`}><Logo size="sm" /></a>
          <p class="muted" style="margin-top:1rem;max-width:34ch">Cyber, network and physical security from one supplier. Based in Sevenoaks, Kent.</p>
        </div>
        <div>
          <h2>By function</h2>
          <ul>{FUNCTIONS.map((f) => <li><a class="fn fn--name" data-fn={f.code} href={`services.html#${f.slug}`} style="font-size:inherit;font-weight:400">{f.name}</a></li>)}</ul>
        </div>
        <div>
          <h2>Services</h2>
          <ul>{SERVICES.map((s) => <li><a href={`${s.slug}.html`}>{s.short}</a></li>)}</ul>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            <li><a href="about.html">About</a></li>
            <li><a href="training.html">Training</a></li>
            <li><a href="careers.html">Careers</a></li>
            <li><a href="contact-us.html">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Contact</h2>
          <ul>
            <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
            <li><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></li>
            <li><a href={CONTACT.mobileHref}>{CONTACT.mobile}</a></li>
            <li><a href={CONTACT.mapHref} target="_blank" rel="noopener">{CONTACT.address.join(', ')}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-base">
        <p>© {new Date().getFullYear()} {COMPANY}</p>
      </div>
    </div>
  </footer>

  <script>
    // Watch line: where "now" sits in the UK day (GMT or BST).
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    const strip = document.querySelector<HTMLElement>('.watch');
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZoneName: 'short' });
    const tick = () => {
      const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((p) => [p.type, p.value]));
      const h = Number(parts.hour) % 24, m = Number(parts.minute);
      if (clock) clock.textContent = `UK ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')} ${parts.timeZoneName}`;
      strip?.style.setProperty('--now', `${((h * 60 + m) / 1440) * 100}%`);
    };
    tick();
    setInterval(tick, 30000);

    // Desktop dropdowns: hover on pointer devices, click and keyboard everywhere.
    document.querySelectorAll<HTMLElement>('.nav-item').forEach((item) => {
      const btn = item.querySelector('button');
      if (!btn) return;
      const set = (open: boolean) => { item.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); };
      btn.addEventListener('click', () => set(!item.classList.contains('open')));
      item.addEventListener('mouseenter', () => matchMedia('(hover: hover)').matches && set(true));
      item.addEventListener('mouseleave', () => matchMedia('(hover: hover)').matches && set(false));
      item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node)) set(false); });
      item.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
    });

    // Mobile menu
    const panel = document.getElementById('mobile-nav')!;
    const opener = document.querySelector<HTMLButtonElement>('.header .burger')!;
    const closeMenu = () => { panel.classList.remove('open'); opener.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; opener.focus(); };
    opener.addEventListener('click', () => { panel.classList.add('open'); opener.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; panel.querySelector<HTMLElement>('[data-close]')?.focus(); });
    panel.querySelector('[data-close]')!.addEventListener('click', closeMenu);
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return closeMenu();
      if (e.key !== 'Tab') return;
      const f = [...panel.querySelectorAll<HTMLElement>('a, button, summary')].filter((el) => el.offsetParent !== null);
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

  </script>
</body>
</html>
