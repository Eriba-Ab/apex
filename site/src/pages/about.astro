---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { VENDOR_FACTS, CONTACT } from '../data/site';
---
<Base title="About" page="about" description="Apex Cyber Security is a cyber security firm based at 52 High Street, Sevenoaks, Kent, covering cyber, network and physical security.">
  <header class="page-head" data-band="ID">
    <div class="wrap">
      <ol class="crumbs"><li><a href="index.html">Home</a></li><li aria-current="page">About</li></ol>
      <h1>One supplier for cyber, network and physical security.</h1>
      <p class="lede">Apex Cyber Security is a cyber security firm based in Sevenoaks, Kent. We help organisations understand their risks, protect what matters and respond fast when something goes wrong.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap split">
      <div class="main">
        <p class="lede">Most organisations buy security in pieces: a consultant for compliance, a provider for monitoring, an installer for the cameras and someone else for the network. The gaps between them are where problems hide.</p>
        <p>We cover the whole picture. Our work runs from governance, risk assessment and compliance readiness, through 24/7 managed detection and response and endpoint protection, to network infrastructure, software development, access control, CCTV and mobile surveillance. We also train analysts and run awareness sessions for staff.</p>
        <p>Every service is organised around the NIST Cybersecurity Framework, so it is easy to see what you have covered and what you still need.</p>
        <h2 class="about-h">How we work</h2>
        <ul class="principles">
          <li><strong>Watchful.</strong> Our security operations centre monitors client environments around the clock.</li>
          <li><strong>Practical.</strong> We recommend what will make the biggest difference first, in plain language.</li>
          <li><strong>Accountable.</strong> One point of contact, from the first assessment to day-to-day support.</li>
        </ul>
        <div class="actions">
          <a class="btn" href="services.html">See services by function <Icon name="arrow" /></a>
          <a class="btn btn--line" href="contact-us.html">Contact us</a>
        </div>
      </div>
      <aside class="side">
        <dl class="vendor vendor--stack">
          {VENDOR_FACTS.map((v) => <><dt>{v.label}</dt><dd>{v.value ?? <span class="pending">{v.pending}</span>}</dd></>)}
        </dl>
        <p class="figcap" style="border:0;margin-top:.5rem"><b>Table 1.</b><span>Supplier facts. Items in italics are still to be confirmed.</span></p>
        <p class="muted" style="margin-top:1.5rem;font-size:var(--t-small)">Visit us at <a href={CONTACT.mapHref} target="_blank" rel="noopener">{CONTACT.address.join(', ')}</a>.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .vendor--stack { grid-template-columns: 1fr; }
  .vendor--stack dd { border-top: 0; padding-top: 0; }
  .about-h { font-size: var(--t-h3); margin: 2.5rem 0 .75rem; }
  .principles { list-style: none; margin: 0; padding: 0; }
  .principles li { padding: 1rem 0; border-top: 1px solid var(--rule); }
  .principles li:last-child { border-bottom: 1px solid var(--rule); }
  .principles strong { display: block; font-family: var(--f-display); font-size: 1.15rem; font-variation-settings: 'wdth' 106; }
</style>
