---
import ServicePage from '../components/ServicePage.astro';
import Icon from '../components/Icon.astro';
---
<ServicePage slug="mobile-surveillance-trailers" description="Solar-powered mobile CCTV trailers from Apex Cyber Security, to rent or buy, for construction sites, car parks, events and remote assets.">
  <section class="section trailer" data-band="DE">
    <div class="wrap trailer-grid">
      <div>
        <h2>Built for sites without power, staff or walls.</h2>
        <p class="lede" style="margin-top:1.5rem">Construction sites, car parks, events and remote assets. Tow it in, raise the mast, and the site is covered.</p>
        <div class="actions">
          <a class="btn" href="contact-us.html">Request a trailer quote <Icon name="arrow" /></a>
        </div>
      </div>
      <table class="table mon">
        <caption><b>Table 2.</b> Monitoring options.</caption>
        <thead><tr><th scope="col">Option</th><th scope="col">What you get</th></tr></thead>
        <tbody>
          <tr><th scope="row" class="t-item">Self-monitoring</th><td class="t-desc">Live feeds at any hour, with zone-based alerts sent to your team by email or text.</td></tr>
          <tr><th scope="row" class="t-item">Monitored</th><td class="t-desc">Alerts watched by trained operators, who escalate to you or the emergency services as agreed.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <div style="height:var(--s6)"></div>
</ServicePage>

<style>
  .trailer-grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s5); align-items: start; }
  .mon caption, .mon caption b { color: var(--fg); }
  .mon th, .mon td { border-color: color-mix(in srgb, var(--fg) 35%, transparent) !important; }
  .mon thead th { border-top-color: var(--fg) !important; color: var(--fg); }
  @media (max-width: 860px) { .trailer-grid { grid-template-columns: 1fr; } }
</style>
