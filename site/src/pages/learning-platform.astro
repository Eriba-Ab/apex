---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CONTACT } from '../data/site';
const learn = [
  'Cybersecurity fundamentals, networking and threat detection',
  'How to analyse security logs and respond to incidents like a SOC professional',
  'Ethical hacking techniques and vulnerability management',
  'Industry best practices, compliance standards and security frameworks',
  'Preparation for the CompTIA Security+ certification',
];
const apart = [
  ['Supplemental certification prep', 'CompTIA Security+, AWS Security Essentials, SANS course alignment, Azure and M365 Security Essentials, and Google Cloud Platform Security Essentials.'],
  ['Industry tools training', 'SIEM essentials, Splunk, Elastic, firewall essentials, SentinelOne, Carbon Black and more.'],
  ['Realistic simulation', 'Emulated IT environments. Blue-team training uses real security tools such as Splunk, real infrastructure and real threats.'],
  ['Additional learning paths', 'SOC Analyst 1 and 2, Web Application Security (OWASP), Threat Hunter, Microsoft Core Security, Cybersecurity Essentials and Secure Coding.'],
  ['Skills development', 'On-demand skills modules, challenges, pre-built and custom learning paths, open-source and commercial security and networking solutions, and Threat-Centric™ upskilling.'],
];
---
<Base title="Learning Platform" page="learning-platform" description="Cybersecurity training with the Apex Institute, powered by CyberBit: a 12-week programme to Junior Cybersecurity Analyst with hands-on labs, real tools and Security+ prep. Free 7-day trial.">
  <header class="page-head" data-band="PR">
    <div class="wrap lp-head">
      <div>
        <ol class="crumbs"><li><a href="index.html">Home</a></li><li>Apex Institute</li><li aria-current="page">Learning Platform</li></ol>
        <h1>Junior Cybersecurity Analyst in 12 weeks.</h1>
        <p class="lede">Cybersecurity training with Apex, powered by CyberBit: a cloud-based simulation and skills platform for hands-on upskilling through realistic, scalable, on-demand cyber exercises.</p>
        <div class="actions">
          <a class="btn" href={`${CONTACT.live}/membership-access`} target="_blank" rel="noopener">Start a 7-day free trial <Icon name="external" /></a>
          <a class="btn btn--line" href={`${CONTACT.live}/membership-access`} target="_blank" rel="noopener">Plan options</a>
        </div>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap split">
      <div class="main">
        <h2>Our approach</h2>
        <p class="lede" style="margin-top:1.25rem">The 12-week programme fast-tracks a learner into the industry with the foundational knowledge, hands-on experience and recognised skills to launch a career as a Junior Cybersecurity Analyst.</p>
        <p>A structured curriculum combines instructor-led sessions, hands-on labs and real-world simulations. Participants learn:</p>
        <ol class="learn">
          {learn.map((l) => <li>{l}</li>)}
        </ol>
      </div>
      <aside class="side">
        <dl class="glance">
          <dt>Length</dt><dd>12 weeks</dd>
          <dt>Format</dt><dd>Instructor-led sessions, labs and simulations</dd>
          <dt>Membership</dt><dd>12 months of Access Tier, mentor support and a private learning community</dd>
          <dt>Try it</dt><dd>Free 7-day trial</dd>
          <dt>Platform</dt><dd>Powered by CyberBit</dd>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <table class="table">
        <caption><b>Table 1.</b> What sets the Apex Institute apart.</caption>
        <thead><tr><th scope="col">Area</th><th scope="col">Detail</th></tr></thead>
        <tbody>{apart.map(([a, d]) => <tr><th scope="row" class="t-item">{a}</th><td class="t-desc">{d}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .learn { margin: 1.25rem 0 0; padding: 0; list-style: none; counter-reset: l; }
  .learn li { counter-increment: l; display: grid; grid-template-columns: 2.5rem 1fr; padding: .8rem 0; border-top: 1px solid var(--rule); }
  .learn li:last-child { border-bottom: 1px solid var(--rule); }
  .learn li::before { content: counter(l); font-family: var(--f-code); font-size: .85rem; color: var(--pr); font-weight: 500; padding-top: .15em; }
</style>
