---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CONTACT } from '../data/site';
---
<Base title="Networking and Learning Events" page="events" description="Networking and learning events from the Apex Institute. New dates to be announced.">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs"><li><a href="index.html">Home</a></li><li>Apex Institute</li><li aria-current="page">Events</li></ol>
      <h1>Networking and learning events.</h1>
      <p class="lede muted">The Apex Institute brings the security community together to learn, meet and hire.</p>
    </div>
  </header>

  <section class="section" style="padding-top:0">
    <div class="wrap split">
      <div class="main empty" style="grid-column:1 / span 8">
        <p class="empty-code code">No events scheduled</p>
        <h2>The next dates will be announced here.</h2>
        <p>Want to hear first, propose a topic, or host an event with us? Email the team and we’ll add you to the list.</p>
        <div class="actions">
          <a class="btn" href={`mailto:${CONTACT.email}?subject=Apex%20events%20list`}><Icon name="mail" />Notify me about events</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .empty { padding: var(--s4) 0; border-top: 2px solid var(--ink); }
  .empty-code { color: var(--rs); margin-bottom: 1rem; }
  .empty h2 { margin-bottom: 1rem; }
  .side-h { font-family: var(--f-text); font-size: var(--t-small); font-weight: 600; color: var(--ink-2); letter-spacing: 0; padding-top: var(--s4); border-top: 2px solid var(--ink); margin-bottom: .5rem; }
  .past { display: grid; gap: .5rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .past-title { font-family: var(--f-display); font-weight: 700; font-size: 1.3rem; font-variation-settings: 'wdth' 106; line-height: 1.15; }
  .past .arrow-link { justify-self: start; }
</style>
