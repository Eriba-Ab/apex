---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" page="404" description="This page could not be found.">
  <header class="page-head">
    <div class="wrap">
      <h1>Page not found.</h1>
      <p class="lede muted">This page isn’t in the profile. It may have moved when the site was rebuilt. Services are now organised by framework function.</p>
      <div class="actions">
        <a class="btn" href="services.html">Browse services <Icon name="arrow" /></a>
        <a class="btn btn--line" href="index.html">Home</a>
      </div>
    </div>
  </header>
</Base>
