---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { FUNCTIONS } from '../data/site';
---
<Base title="Our Vision" page="our-vision" description="Apex Cybersecurity Solutions' mission: to be an outstanding, first-class cybersecurity defender and leader. We watch, we protect, our focus is you.">
  <header class="page-head vision-head" data-band="INK">
    <div class="wrap">
      <ol class="crumbs"><li><a href="index.html">Home</a></li><li>About</li><li aria-current="page">Our Vision</li></ol>
      <p class="vision-line">We watch, we protect, <span>our focus is you.</span></p>
    </div>
    <div class="vision-bar" aria-hidden="true">{FUNCTIONS.map((f) => <i data-band={f.code}></i>)}</div>
  </header>

  <section class="section">
    <div class="wrap split">
      <div class="main">
        <h1 class="vision-h1">Our vision</h1>
        <p class="lede">Apex Cybersecurity Solutions is a technology company with a mission to be an outstanding, first-class cybersecurity defender and leader: one that consistently crafts and delivers superlative IT solutions and resilient, threat-mitigating outcomes.</p>
        <p>Our goal is to provide solutions that protect, delight and astound our clients.</p>
      </div>
      <aside class="side">
        <h2 class="side-h">What that means in practice</h2>
        <ul class="vision-list">
          <li><strong>We watch.</strong> Security Conservators (SC)® monitor client environments around the clock.</li>
          <li><strong>We protect.</strong> From endpoints to front doors, we build defences that hold.</li>
          <li><strong>Our focus is you.</strong> Every engagement is scoped to your organisation, not a template.</li>
        </ul>
        <a class="arrow-link" href="team.html" style="margin-top:1.5rem">Meet the leadership <Icon name="arrow" /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .vision-head { padding-bottom: 0; }
  .vision-line { margin: var(--s4) 0 var(--s5); max-width: 16ch; font-family: var(--f-display); font-weight: 800; font-variation-settings: 'wdth' 118; font-size: clamp(2.8rem, 1.5rem + 5.5vw, 6rem); line-height: .95; letter-spacing: -.035em; }
  .vision-line span { color: var(--gv); }
  .vision-bar { display: grid; grid-template-columns: repeat(6, 1fr); height: 14px; }
  .vision-bar i { background: var(--bg); }
  .vision-h1 { font-size: var(--t-h2); margin-bottom: 1.5rem; }
  .side-h { font-family: var(--f-text); font-size: var(--t-small); font-weight: 600; color: var(--ink-2); letter-spacing: 0; margin-bottom: .75rem; }
  .vision-list { list-style: none; margin: 0; padding: 0; }
  .vision-list li { padding: 1rem 0; border-top: 1px solid var(--rule); }
  .vision-list li:last-child { border-bottom: 1px solid var(--rule); }
  .vision-list strong { display: block; font-family: var(--f-display); font-size: 1.2rem; font-variation-settings: 'wdth' 106; }
</style>
