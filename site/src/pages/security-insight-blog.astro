---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { POSTS, fn } from '../data/site';
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Security Blog" page="security-insight-blog" description="Security insight from Apex Cybersecurity Solutions: threats, incidents and practical advice from Damond Singleton and the Apex team.">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs"><li><a href="index.html">Home</a></li><li>Apex Institute</li><li aria-current="page">Security Blog</li></ol>
      <h1>Security insight.</h1>
      <p class="lede muted">Threats in the news, what they mean for your organisation, and what to do about them.</p>
    </div>
  </header>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <ol class="posts">
        {POSTS.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener">
              <time datetime={p.date} class="code">{fmt(p.date)}</time>
              <span class="p-body">
                <span class="p-title">{p.title}</span>
                <span class="p-meta">Damond Singleton · <span class="fn fn--name" data-fn={p.fn}>{fn(p.fn).name}</span></span>
              </span>
              {p.img ? <img src={p.img} alt="" loading="lazy"> : <span class="p-noimg" data-band={p.fn}>{p.fn}</span>}
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .posts a { display: grid; grid-template-columns: 11rem 1fr 180px 1.25rem; gap: var(--s4); align-items: center; padding: var(--s3) 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .posts time { color: var(--ink-2); align-self: start; padding-top: .35rem; }
  .p-body { display: grid; gap: .6rem; }
  .p-title { font-family: var(--f-display); font-weight: 700; font-size: clamp(1.3rem, 1.1rem + .8vw, 1.9rem); line-height: 1.12; letter-spacing: -.015em; font-variation-settings: 'wdth' 106; text-wrap: balance; }
  .p-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; font-size: var(--t-small); color: var(--ink-2); }
  .posts img, .p-noimg { width: 180px; aspect-ratio: 3 / 2; object-fit: cover; }
  .p-noimg { display: grid; place-items: center; font-family: var(--f-display); font-weight: 800; font-size: 2.5rem; font-variation-settings: 'wdth' 125; }
  .posts svg { width: 1.25rem; height: 1.25rem; transition: transform .3s var(--ease); }
  .posts a:hover svg { transform: translateX(5px); }
  .posts a:hover .p-title { color: var(--id); }
  @media (max-width: 860px) {
    .posts a { grid-template-columns: 1fr 96px; gap: .75rem 1rem; }
    .posts time { grid-column: 1 / -1; padding: 0; }
    .posts img, .p-noimg { width: 96px; }
    .posts svg { display: none; }
  }
</style>
